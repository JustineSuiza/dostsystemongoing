# Copy this file to ".env" (same folder) and fill in the real values.
# .env is gitignored - never commit the real .env file.

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# "production" disables the debug toolbar and error details
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# Public URL of THIS backend, with a trailing slash (must be https)
app.baseURL = 'https://YOUR-API-DOMAIN/'

#--------------------------------------------------------------------
# FRONTEND
#--------------------------------------------------------------------
# Public URL of the React frontend (used in password-reset emails)
frontend.baseURL = 'https://justinez.web.app'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = YOUR_DB_NAME
database.default.username = YOUR_DB_USER
database.default.password = YOUR_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
# session.expiration = 7200

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# logger.threshold = 3
